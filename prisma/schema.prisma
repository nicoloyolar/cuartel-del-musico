// Cuartel del Músico — esquema de datos
// Cubre: staff (auth), bandas/clientes, reservas de sala, inventario de equipos,
// cobros por arriendo, y la configuración del canal de streaming público.

generator client {
  provider = "prisma-client-js"
  // El hosting real resultó ser el producto Node.js "web app" de Hostinger
  // (deploy vía Git, build en su propio servidor) — ese build corre `npm
  // install`/`prisma generate` en su propia infraestructura, así que en
  // teoría ya genera el engine correcto solo. Se deja igual este binario
  // Linux (glibc) de más como red de seguridad barata, por si alguna vez se
  // vuelve a necesitar un build local para subir a mano.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // MySQL compartido de Hostinger: el usuario no tiene permiso de crear
  // bases, así que `migrate dev` necesita esta base separada (vacía, solo
  // para uso interno de Prisma) para poder seguir teniendo historial de
  // migraciones versionado.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(OPERADOR)
  createdAt    DateTime @default(now())
}

model Banda {
  id        String    @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  instagram String?
  notas     String?
  createdAt DateTime  @default(now())
  reservas  Reserva[]
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Reserva {
  id               String        @id @default(cuid())
  bandaId          String
  banda            Banda         @relation(fields: [bandaId], references: [id], onDelete: Cascade)
  inicio           DateTime
  fin              DateTime
  estado           EstadoReserva @default(CONFIRMADA)
  transmitirEnVivo Boolean       @default(true)
  precio           Float?
  notas            String?
  createdAt        DateTime      @default(now())
  cobros           Cobro[]

  @@index([inicio])
}

enum EstadoEquipo {
  DISPONIBLE
  PRESTADO
  MANTENCION
}

model Equipo {
  id         String       @id @default(cuid())
  nombre     String
  categoria  String?
  estado     EstadoEquipo @default(DISPONIBLE)
  notas      String?
  createdAt  DateTime     @default(now())
}

model Cobro {
  id        String   @id @default(cuid())
  reservaId String
  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  monto     Float
  metodo    String?
  pagado    Boolean  @default(false)
  fecha     DateTime @default(now())
  notas     String?
}

// Configuración única (fila con id=1) que controla qué se muestra en el
// sitio público: el canal simulado armado con `CanalItem` (fase 1) o una
// señal en vivo real de YouTube (fase 2), sin necesidad de tocar código.
model StreamConfig {
  id        Int      @id @default(1)
  modo      String   @default("playlist") // "playlist" | "live"
  youtubeId String? // solo se usa en modo "live": ID del video/transmisión en vivo
  titulo    String?
  updatedAt DateTime @updatedAt
}

// Lista de reproducción del "canal" que se ve en la home mientras no hay
// streaming en vivo real. A diferencia de un embed de playlist de YouTube
// (que cada visitante arranca desde cero, todos ven algo distinto según
// cuándo entraron), esto simula un canal de TV/radio real: se calcula por
// reloj de servidor en qué item + segundo debería estar "sonando ahora" y
// todos los visitantes ven ese mismo punto — igual que Pluto TV o un canal
// de streaming lineal armado sobre contenido grabado. Ver `src/lib/canal.ts`.
// Editable desde /panel/canal.
model CanalItem {
  id               String   @id @default(cuid())
  titulo           String
  youtubeId        String
  duracionSegundos Int      @default(240)
  orden            Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([orden])
}

// Catálogo "modo Netflix": sesiones grabadas de bandas de la escena de
// Concepción para que el público explore y elija qué ver, aparte del
// canal continuo ("radio-tv") de la home. Editable desde /panel/sesiones.
model Sesion {
  id          String   @id @default(cuid())
  bandaNombre String
  titulo      String
  youtubeId   String
  descripcion String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([orden])
}
