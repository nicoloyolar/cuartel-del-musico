// Cuartel del Músico — esquema de datos
// Cubre: staff (auth), bandas/clientes, reservas de sala, inventario de equipos,
// cobros por arriendo, y la configuración del canal de streaming público.

generator client {
  provider = "prisma-client-js"
  // El hosting real resultó ser el producto Node.js "web app" de Hostinger
  // (deploy vía Git, build en su propio servidor) — ese build corre `npm
  // install`/`prisma generate` en su propia infraestructura, así que en
  // teoría ya genera el engine correcto solo. Se deja igual este binario
  // Linux (glibc) de más como red de seguridad barata, por si alguna vez se
  // vuelve a necesitar un build local para subir a mano.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  // MySQL compartido de Hostinger: el usuario no tiene permiso de crear
  // bases, así que `migrate dev` necesita esta base separada (vacía, solo
  // para uso interno de Prisma) para poder seguir teniendo historial de
  // migraciones versionado.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(OPERADOR)
  createdAt    DateTime @default(now())
}

model Banda {
  id        String    @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  instagram String?
  notas     String?
  createdAt DateTime  @default(now())
  reservas  Reserva[]
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Reserva {
  id               String        @id @default(cuid())
  bandaId          String
  banda            Banda         @relation(fields: [bandaId], references: [id], onDelete: Cascade)
  inicio           DateTime
  fin              DateTime
  estado           EstadoReserva @default(CONFIRMADA)
  transmitirEnVivo Boolean       @default(true)
  precio           Float?
  notas            String?
  createdAt        DateTime      @default(now())
  cobros           Cobro[]

  @@index([inicio])
}

enum EstadoEquipo {
  DISPONIBLE
  PRESTADO
  MANTENCION
}

model Equipo {
  id         String       @id @default(cuid())
  nombre     String
  categoria  String?
  estado     EstadoEquipo @default(DISPONIBLE)
  notas      String?
  createdAt  DateTime     @default(now())
}

model Cobro {
  id        String   @id @default(cuid())
  reservaId String
  reserva   Reserva  @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  monto     Float
  metodo    String?
  pagado    Boolean  @default(false)
  fecha     DateTime @default(now())
  notas     String?
}

// Configuración única (fila con id=1) que controla qué se muestra en el
// sitio público: el canal simulado armado con `CanalItem` (fase 1) o una
// señal en vivo real de YouTube (fase 2), sin necesidad de tocar código.
model StreamConfig {
  id        Int      @id @default(1)
  modo      String   @default("playlist") // "playlist" | "live"
  youtubeId String? // solo se usa en modo "live": ID del video/transmisión en vivo
  titulo    String?
  updatedAt DateTime @updatedAt
}

// Las dos secciones de programación del canal (a pedido del usuario:
// "radio TV streaming" y "podcast") — qué sección suena ahora se decide por
// BloqueHorario; sin bloques configurados, el canal se comporta como antes
// de esta feature (todo RADIO_TV, un solo ciclo).
enum SeccionCanal {
  RADIO_TV
  PODCAST
}

// Lista de reproducción del "canal" que se ve en la home mientras no hay
// streaming en vivo real. A diferencia de un embed de playlist de YouTube
// (que cada visitante arranca desde cero, todos ven algo distinto según
// cuándo entraron), esto simula un canal de TV/radio real: se calcula por
// reloj de servidor en qué item + segundo debería estar "sonando ahora" y
// todos los visitantes ven ese mismo punto — igual que Pluto TV o un canal
// de streaming lineal armado sobre contenido grabado. Ver `src/lib/canal.ts`.
// Editable desde /panel/canal. Cada sección tiene su propio ciclo/orden
// (el cálculo de posición corre por separado sobre los items de esa
// sección) — ver `seccionActiva` en `src/lib/horarios.ts` para cómo se
// decide cuál sección está al aire en cada momento.
model CanalItem {
  id               String       @id @default(cuid())
  titulo           String
  youtubeId        String
  duracionSegundos Int          @default(240)
  orden            Int          @default(0)
  seccion          SeccionCanal @default(RADIO_TV)
  createdAt        DateTime     @default(now())
  // Se marca solo (sin login: ver marcarCanalItemBloqueado en actions.ts)
  // cuando el reproductor detecta que YouTube rechaza embeberlo (ej. un
  // reclamo de Content ID como LatinAutor-UMPG) — el item se saca del ciclo
  // de programación sin borrar el registro, reversible desde /panel/canal.
  bloqueado        Boolean      @default(false)

  @@index([orden])
  @@index([seccion])
}

// Horario semanal: qué sección (RADIO_TV o PODCAST) debe estar al aire según
// el día y la hora. Si el momento actual no cae dentro de ningún bloque, se
// usa RADIO_TV por defecto (ver seccionActiva). Si hay bloques con horarios
// superpuestos, gana el primero en orden de creación — ver seccionActiva.
// Editable desde /panel/horarios.
model BloqueHorario {
  id            String       @id @default(cuid())
  seccion       SeccionCanal
  // Días de la semana en que aplica, formato JS Date#getDay (0=domingo..
  // 6=sábado) separados por coma, ej "1,2,3,4,5" para lunes a viernes.
  dias          String
  horaInicioMin Int // minutos desde medianoche (0-1439)
  horaFinMin    Int // minutos desde medianoche (1-1440) — si es menor o igual
  // a horaInicioMin, el bloque cruza medianoche (ej 22:00 a 02:00)
  createdAt     DateTime     @default(now())
}

// Catálogo "modo Netflix": sesiones grabadas de bandas de la escena de
// Concepción para que el público explore y elija qué ver, aparte del
// canal continuo ("radio-tv") de la home. Editable desde /panel/sesiones.
model Sesion {
  id          String   @id @default(cuid())
  bandaNombre String
  titulo      String
  youtubeId   String
  descripcion String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([orden])
}

// ---- Cuartel del Músico Plus ----
// Cuentas de público que pagan por acceso a contenido exclusivo. Separadas
// a propósito de `User` (que es solo staff del panel, vía NextAuth
// Credentials): acá el login es de autoservicio (cualquiera se registra) y
// usa su propia sesión por cookie firmada (ver src/lib/suscriptorSession.ts),
// no NextAuth. v1 pragmática (a pedido del usuario, para lanzar rápido):
// pago único por período, sin cobro recurrente automático — activaHasta se
// extiende manualmente cada vez que se aprueba un pago (ver PagoPlus).
model Suscriptor {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  nombre       String?
  // null = nunca pagó. Si es una fecha pasada, la suscripción venció y no
  // tiene acceso a /plus hasta volver a pagar — ver src/lib/plusAcceso.ts.
  activaHasta  DateTime?
  createdAt    DateTime   @default(now())
  pagos        PagoPlus[]
  resetTokens  ResetTokenPlus[]
}

// Token de "olvidé mi contraseña" para Suscriptor. Se guarda solo el hash
// (SHA-256) del token, no el valor plano — el link que se manda por email
// lleva el token real, así que si la base se filtra no alcanza para
// resetear contraseñas ajenas. Un solo uso (`usado`) y vence rápido.
model ResetTokenPlus {
  id           String     @id @default(cuid())
  suscriptorId String
  suscriptor   Suscriptor @relation(fields: [suscriptorId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiraEn     DateTime
  usado        Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([suscriptorId])
}

// Un intento de pago (uno por cada vez que alguien aprieta "pagar"), para
// trazabilidad/soporte y para que el webhook de MercadoPago tenga contra
// qué fila matchear (external_reference = este id). "pendiente" hasta que
// el webhook confirma el resultado.
model PagoPlus {
  id           String     @id @default(cuid())
  suscriptorId String
  suscriptor   Suscriptor @relation(fields: [suscriptorId], references: [id], onDelete: Cascade)
  monto        Int // CLP
  estado       String     @default("pendiente") // "pendiente" | "aprobado" | "rechazado"
  referenciaMp String? // id de pago de MercadoPago, una vez que el webhook lo confirma
  createdAt    DateTime   @default(now())

  @@index([suscriptorId])
}

// Catálogo de contenido exclusivo Plus: videos "ocultos" (unlisted) de
// YouTube — mismo mecanismo validado en /panel/pruebas-streaming/oculto (un
// unlisted embebe igual que uno público, pero no aparece en listados de
// YouTube). Editable desde /panel/plus.
model VideoPlus {
  id          String   @id @default(cuid())
  titulo      String
  youtubeId   String
  descripcion String?
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([orden])
}

// Configuración única (fila con id=1) del plan Plus — precio editable desde
// /panel/plus sin tocar código, mismo patrón que StreamConfig.
model PlanPlusConfig {
  id            Int      @id @default(1)
  nombre        String   @default("Cuartel del Músico Plus")
  precioMensual Int      @default(4990) // CLP
  updatedAt     DateTime @updatedAt
}
